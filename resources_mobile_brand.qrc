<RCC>
    <qresource prefix="/images/calicata">
        <file alias="lab-beaker.svg">images/calicata/lab-beaker.svg</file>
        <file alias="site-engineer.png">images/calicata/site-engineer.png</file>
        <file alias="site-engineer-field.png">images/calicata/site-engineer-field.png</file>
        <file alias="site-engineer-ingema.png">images/calicata/site-engineer-ingema.png</file>
        <file alias="site-engineer-animated.mp4">images/calicata/site-engineer-animated.mp4</file>
        <file alias="pomp-intro-original.mp4">images/calicata/pomp-intro-original.mp4</file>
        <file alias="pomp-cry-original.mp4">images/calicata/pomp-cry-original.mp4</file>
        <file alias="pomp-cry-loop.mp4">images/calicata/pomp-cry-loop.mp4</file>
        <file alias="photo-view.svg">images/calicata/photo-view.svg</file>
        <file alias="photo-edit.svg">images/calicata/photo-edit.svg</file>
        <file alias="photo-camera.svg">images/calicata/photo-camera.svg</file>
        <file alias="photo-upload.svg">images/calicata/photo-upload.svg</file>
    </qresource>
    <!-- Mobile Calicatas only: retain QRC aliases used by exporter and photographs. -->
    <!-- Desktop retains the original resources.qrc file unchanged. -->
    <qresource prefix="/images">
        <file alias="ICONO_LOGO_MTC.jpeg">images/ICONO_LOGO_MTC.jpeg</file>
        <file alias="INGEMA_LOGO_COMPLETO.png">images/INGEMA_LOGO_COMPLETO.png</file>
        <file alias="INGEMA_CONSULTORES_LOGO.png">images/INGEMA_CONSULTORES_LOGO.png</file>
        <file alias="INGEMA_CONSULTORES_LOGO_NEGATIVO.png">images/INGEMA_CONSULTORES_LOGO_NEGATIVO.png</file>
        <file alias="HVA_GROUP_LOGO.png">images/HVA_GROUP_LOGO.png</file>
        <file alias="HVA_GROUP_LOGO_NEGATIVO.png">images/HVA_GROUP_LOGO_NEGATIVO.png</file>
        <file alias="INGEPLUS_LOGO_2026.png">images/INGEPLUS_LOGO_2026.png</file>
        <file alias="default_avatar_men.png">images/default_avatar_men.png</file>
        <file alias="google_mark.png">images/google_mark.png</file>
        <file alias="supabase_mark.png">images/supabase_mark.png</file>
        <file alias="halloween/pumpkin.svg">images/halloween/pumpkin.svg</file>
        <file alias="halloween/ghost.svg">images/halloween/ghost.svg</file>
        <file alias="halloween/bat.svg">images/halloween/bat.svg</file>
        <file alias="halloween/cat.svg">images/halloween/cat.svg</file>
        <file alias="halloween/candy.svg">images/halloween/candy.svg</file>
        <file alias="halloween/web.svg">images/halloween/web.svg</file>
        <file alias="halloween/moon.svg">images/halloween/moon.svg</file>
        <file alias="halloween/star.svg">images/halloween/star.svg</file>
        <file alias="halloween/hat.svg">images/halloween/hat.svg</file>
        <file alias="halloween/boo.wav">images/halloween/boo.wav</file>
    </qresource>
    <!-- Semilla de InGe Drive › Recursos (DocsController/DocsOps): mismos archivos
         y misma ruta :/Logos/images/... que el Desktop (resources.qrc). -->
    <qresource prefix="/Logos">
        <file>images/ICONO_LOGO_MTC.jpeg</file>
        <file>images/aldesa_logo.png</file>
    </qresource>
</RCC>
