<RCC>
    <qresource prefix="/images/calicata">
        <file alias="lab-beaker.svg">images/calicata/lab-beaker.svg</file>
        <file alias="site-engineer.png">images/calicata/site-engineer.png</file>
        <file alias="site-engineer-field.png">images/calicata/site-engineer-field.png</file>
        <file alias="site-engineer-ingema.png">images/calicata/site-engineer-ingema.png</file>
        <file alias="site-engineer-animated.mp4">images/calicata/site-engineer-animated.mp4</file>
        <file alias="pomp-intro-original.mp4">images/calicata/pomp-intro-original.mp4</file>
        <file alias="pomp-cry-original.mp4">images/calicata/pomp-cry-original.mp4</file>
        <file alias="pomp-cry-loop.mp4">images/calicata/pomp-cry-loop.mp4</file>
        <file alias="photo-view.svg">images/calicata/photo-view.svg</file>
        <file alias="photo-edit.svg">images/calicata/photo-edit.svg</file>
        <file alias="photo-camera.svg">images/calicata/photo-camera.svg</file>
        <file alias="photo-upload.svg">images/calicata/photo-upload.svg</file>
    </qresource>
    <!-- Mobile Calicatas only: retain QRC aliases used by exporter and photographs. -->
    <!-- Desktop retains the original resources.qrc file unchanged. -->
    <qresource prefix="/images">
        <file alias="ICONO_LOGO_MTC.jpeg">images/ICONO_LOGO_MTC.jpeg</file>
        <file alias="INGEMA_LOGO_COMPLETO.png">images/INGEMA_LOGO_COMPLETO.png</file>
        <file alias="default_avatar_men.png">images/default_avatar_men.png</file>
    </qresource>
</RCC>
