  <property name="styleSheet">
   <string notr="true">/* fondo*/
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #E3F2FD, stop:1 #FFFFFF);
}

/*texto*/
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #90CAF9;
    border-radius: 10px;
    padding: 8px;
    font-size: 14px;
    color: #0D47A1;
}

QLineEdit:focus {
    border: 2px solid #1E88E5;
    background-color: #E3F2FD;
}

/* ===== Botón de acceso ===== */
QPushButton {
    background-color: #2196F3;
    color: white;
    border-radius: 12px;
    padding: 10px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #1976D2;
}

QPushButton:pressed {
    background-color: #1565C0;
}

QCheckBox {
    color: #0F1F2A;
    font-size: 10pt;
    font-weight: 600;
    spacing: 8px;
    background: transparent;
    padding-top: 2px;
    padding-bottom: 2px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #FDAC11;   /* naranja logo: desactivado */
    border-radius: 5px;
    background: #FFF8EC;
}

QCheckBox::indicator:hover {
    border: 2px solid #FFB52B;
    background: #FFF3D9;
}

QCheckBox::indicator:pressed {
    border: 2px solid #E59A00;
    background: #FFE9BF;
}

QCheckBox::indicator:checked {
    border: 2px solid #6FC04A;   /* verde logo: activado */
    border-radius: 5px;
    background: #EEF9E8;
    image: url(:/icons/check_blue.svg);   /* check azul */
}

QCheckBox::indicator:checked:hover {
    border: 2px solid #62B53E;
    background: #E7F6DE;
    image: url(:/icons/check_blue.svg);
}

QCheckBox::indicator:checked:pressed {
    border: 2px solid #62B53E;
    background: #DDF1D2;
    image: url(:/icons/check_blue.svg);
}

QCheckBox:disabled {
    color: #7A8A96;
}</string>
