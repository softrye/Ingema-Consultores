                   <property name="styleSheet">
                    <string notr="true">/* QCheckBox base: sin fondo ni borde, tamaño mínimo */
#chkGpsActivo {
    margin: 0px;
    padding: 0px;
    background: transparent;
    border: none;
}

/* Píldora del switch */
#chkGpsActivo::indicator {
    width: 40px;
    height: 20px;
    border-radius: 10px;
    background-color: #cccccc;    /* apagado */
    border: 1px solid #888888;
}

/* Encendido (verde) */
#chkGpsActivo::indicator:checked {
    background-color: #2ecc71;
    border: 1px solid #1e874b;
}
</string>
