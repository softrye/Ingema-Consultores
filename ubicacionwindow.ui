             <property name="styleSheet">
              <string notr="true">/* Fondo general del área de contenido */
QWidget {
    background-color: #f5f7fb;
}

/* Estilo base para todos los QFrame */
QFrame {
    background-color: #ffffff;
    border-radius: 8px;
    border: 1px solid #d0d4e4;
}

/* Texto por defecto: NEGRO */
QLabel {
    color: #1b2a4e;  /* negro azulado */
    font-size: 10pt;
}

/* ---------- BARRA GPS ON/OFF (AZUL) ---------- */
QFrame#frameGpsToggle {
    background-color: #0b74d1;   /* azul */
    border-radius: 8px;
    border: none;
}

/* Título dentro de la barra GPS → negro */
QLabel#lblGpsTitulo {
    color: #1b2a4e;
    font-weight: bold;
    font-size: 10pt;
}

/* Switch */
QCheckBox#chkGpsActivo {
    spacing: 0px;
}

QCheckBox#chkGpsActivo::indicator {
    width: 36px;
    height: 18px;
    border-radius: 9px;
    background-color: #d0d4e4;
    border: 1px solid rgba(0,0,0,40%);
}

QCheckBox#chkGpsActivo::indicator:checked {
    background-color: #4cd964;  /* verde */
    border: 1px solid rgba(0,0,0,20%);
}

/* ---------- MAPA REFERENCIAL ---------- */
QFrame#frameMapa {
    background-color: #ffffff;
    border: 1px solid #c2cee8;
}

QLabel#lblMapaTitulo {
    font-weight: bold;
    font-size: 11pt;
    color: #1b2a4e;
}

/* ---------- TARJETA DATOS UBICACIÓN ---------- */
/* Tarjeta contenedora: azul, como la barra de GPS */
QFrame#groupDatosUbicacion {
    background-color: #0b74d1;   /* mismo azul que el GPS */
    border-radius: 8px;
    border: none;
    padding: 10px 14px;
}

/* Texto dentro de la tarjeta → negro */
QFrame#groupDatosUbicacion QLabel {
    color: #1b2a4e;
    font-weight: 600;
}

/* Cada “renglón” (frames hijos directos) en blanco, estilo tarjeta */
QFrame#groupDatosUbicacion &gt; QFrame {
    background-color: #ffffff;
    border-radius: 8px;
    border: 1px solid #d0d4e4;
}

/* Campos de datos: line edit y combo en blanco */
QFrame#groupDatosUbicacion QLineEdit,
QFrame#groupDatosUbicacion QComboBox {
    border: 1px solid #c2cee8;
    border-radius: 6px;
    padding: 2px 6px;
    background-color: #f9fbff;
    color: #1b2a4e;
}

/* QComboBox: flecha discreta */
QFrame#groupDatosUbicacion QComboBox::drop-down {
    border: none;
    width: 18px;
}

QFrame#groupDatosUbicacion QComboBox::down-arrow {
    image: none;
}

/* ---------- CAMPOS ESPECIALES EN DATOS DE UBICACIÓN ---------- */

/* Hora (QTimeEdit) */
QFrame#groupDatosUbicacion QTimeEdit {
    border: 1px solid #c2cee8;
    border-radius: 4px;
    padding: 2px 4px;
    background-color: #f9fbff;
    color: #1b2a4e;                /* texto negro */
    selection-background-color: #e3f2ff;
    selection-color: #1b2a4e;
}

/* ComboBox del sistema de coordenadas */
QComboBox#cboSistemaCoord {
    border: 1px solid #c2cee8;
    border-radius: 4px;
    padding: 2px 6px;
    background-color: #f9fbff;
    color: #1b2a4e;                /* texto negro en la parte cerrada */
}

/* Lista desplegable del ComboBox */
QComboBox#cboSistemaCoord QAbstractItemView {
    background-color: #ffffff;
    color: #1b2a4e;                /* texto negro en las opciones */
    selection-background-color: #e3f2ff;
    selection-color: #1b2a4e;
}
</string>
