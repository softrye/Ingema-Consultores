  <property name="styleSheet">
   <string notr="true">/* =========================================================
   InGe+ — CorteRowWidget (match CalicataWindow palette)
   Primary/Teal  #0087AE
   Navy          #005282
   Accent        #FDAC11
   Success       #6FC04A
   ========================================================= */

QWidget#CorteRowWidget {
    background: transparent;
    border-radius: 12px;
}

/* Card principal */
QWidget#CorteWidgetCont {
    background-color: #D9EDF3;
    border: 1px solid rgba(0,135,174,65);
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* Limpia fondos “oscuros” heredados de Designer dentro del card */
QWidget#CorteWidgetCont QFrame{
    background: transparent;
    border-radius: 12px;
    border: none;
}

/* Barra superior del corte */
QWidget#headerBar {
    background-color: #005282;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid rgba(255,255,255,18);
    padding: 4px 8px;
}

/* Título del corte en header */
QWidget#headerBar QLabel,
QLabel#lblCorteTitulo {
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,26);
    border-top-left-radius: 12px;
}

/* Botón eliminar (QToolButton) */
QToolButton#btnEliminarCorte{
    background-color: rgba(255,255,255,10);
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,35);
    border-radius: 9px;
    padding: 0px;
}

QToolButton#btnEliminarCorte:hover{
    /* más oscuro, no gris */
    background-color: rgba(0,0,0,14);
    border: 1px solid rgba(255,255,255,45);
}
QToolButton#btnEliminarCorte:pressed{
    background-color: rgba(0,0,0,22);
}

/* Labels del cuerpo (fuera del header) */
QWidget#CorteWidgetCont QLabel {
    color: #005282;
    font-weight: bold;
}

/* Inputs dentro del corte (compatibles con tu estilo general) */
QWidget#CorteWidgetCont QLineEdit,
QWidget#CorteWidgetCont QTextEdit,
QWidget#CorteWidgetCont QPlainTextEdit,
QWidget#CorteWidgetCont QComboBox {
    background-color: #FFFFFF;
    color: #0F1F2A;
    border: 1px solid rgba(0,135,174,70);
    border-radius: 10px;
    padding: 5px 8px;
}

QWidget#CorteWidgetCont QLineEdit:focus,
QWidget#CorteWidgetCont QTextEdit:focus,
QWidget#CorteWidgetCont QPlainTextEdit:focus,
QWidget#CorteWidgetCont QComboBox:focus {
    border: 2px solid rgba(0,135,174,180);
}


QWidget#CorteWidgetCont QComboBox::drop-down {
    border-left: 1px solid rgba(0,135,174,70);
    width: 24px;
}




/* =========================================================
   COMBOBOX POPUP (GLOBAL)
   - Fondo navy (#005282)
   - Items blanco
   - Hover invertido (fondo blanco + texto oscuro)
   - Bordes redondeados reales (QComboBoxPrivateContainer)
   - Evita '...' en combos angostos (min-width + padding moderado)
   ========================================================= */

/* ===========================
   POPUP ComboBox (dentro del corte)
   =========================== */

QWidget#CorteWidgetCont QComboBoxPrivateContainer {
    background-color: #005282;
    border: 1px solid rgba(255,255,255,28);
    border-radius: 12px;
    padding: 4px;
}

QWidget#CorteWidgetCont QComboBoxPrivateContainer QAbstractItemView {
    background-color: #005282;
    border: none;
    outline: 0;
    color: #FFFFFF;
    border-radius: 10px;
}

QWidget#CorteWidgetCont QComboBoxPrivateContainer QAbstractItemView::viewport {
    background-color: #005282;
    border-radius: 10px;
}



QWidget#CorteWidgetCont QComboBoxPrivateContainer QAbstractItemView::item {
    padding: 6px 10px;
    color: #FFFFFF;
    background: transparent;
}

QWidget#CorteWidgetCont QComboBoxPrivateContainer QAbstractItemView::item:hover {
    background-color: #FFFFFF;
    color: #0F1F2A;
}

QWidget#CorteWidgetCont QComboBoxPrivateContainer QAbstractItemView::item:selected {
    background-color: rgba(255,255,255,220);
    color: #0F1F2A;
}


/* (Opcional) Scrollbar dentro del popup para que no se vea “default” */
QComboBoxPrivateContainer QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QComboBoxPrivateContainer QScrollBar::handle:vertical {
    background: rgba(255,255,255,35);
    border-radius: 5px;
    min-height: 18px;
}
QComboBoxPrivateContainer QScrollBar::handle:vertical:hover {
    background: rgba(255,255,255,55);
}
QComboBoxPrivateContainer QScrollBar::add-line:vertical,
QComboBoxPrivateContainer QScrollBar::sub-line:vertical {
    height: 0px;
}

QWidget#CorteWidgetCont QComboBox { combobox-popup: 0; border-radius: 12px; }

QMenu {
    background-color: #005282;
    border: 1px solid rgba(255,255,255,28);
    border-radius: 12px;
    padding: 4px;
}

QMenu::item {
    color: #FFFFFF;
    padding: 6px 10px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: #FFFFFF;
    color: #0F1F2A;
}


</string>
