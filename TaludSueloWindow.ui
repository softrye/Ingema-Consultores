/* =========================
   Base
   ========================= */
QMainWindow#TaludSueloWindow,
QWidget#centralwidget {
    background-color: #005282;
    color: #0F1F2A;
}

/* =========================
   Scroll principal
   ========================= */
QAbstractScrollArea#scrollAreaMain,
QScrollArea#scrollAreaMain,
QScrollArea#scrollAreaMain &gt; QWidget#qt_scrollarea_viewport,
QWidget#scrollAreaWidgetContents {
    background: transparent;
    border: none;
}

/* =========================
   Scrollbars
