}

/* =========================
   Checkboxes
   ========================= */
QMainWindow#TaludSueloWindow QCheckBox {
    background: transparent;
    color: #0F1F2A;
    spacing: 6px;
}

QMainWindow#TaludSueloWindow QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background-color: #FFFFFF;
    border: 1px solid #7FB8CB;
    border-radius: 3px;
}

QMainWindow#TaludSueloWindow QCheckBox::indicator:hover {
    background-color: #F5FBFD;
    border: 1px solid #0087AE;
}

QMainWindow#TaludSueloWindow QCheckBox::indicator:checked {
    width: 14px;
    height: 14px;
    background-color: #FFFFFF;
    border: 1px solid #6FC04A;
    image: url(:/icons/images/check_green.svg);
}

QMainWindow#TaludSueloWindow QCheckBox::indicator:checked:hover {
    background-color: #F8FFF4;
    border: 1px solid #62B53E;
    image: url(:/icons/images/check_green.svg);
}

/* =========================
   Combo / Date visual
   ========================= */
