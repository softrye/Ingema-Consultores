  <property name="styleSheet">
   <string notr="true">/* =========================================================
   InGe+ — CalicataWindow (BRAND LIGHT BLUE - LOGO TRUE PALETTE)
   Depurado:
   - Sin hover/pressed repetidos para clear / pick / foto grande
   - Override final único para esos widgets
   ========================================================= */

/* ---------- Base ---------- */
QMainWindow#CalicataWindow,
QWidget#centralwidget {
    background-color: #005282;
    color: #0F1F2A;
}

/* No pintes TODOS los frames */
QFrame { background: transparent; border: none; }

/* ---------- ToolBar / barra superior ---------- */
QToolBar {
    background-color: #005282;
    border: none;
    spacing: 6px;
    padding: 6px;
}

QToolBar QToolButton {
    background: rgba(255,255,255,10);
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,35);
    border-radius: 10px;
    padding: 6px 10px;
}

QToolBar QToolButton:hover {
    background: rgba(255,255,255,18);
}

QToolBar QToolButton:pressed {
    background: rgba(0,0,0,12);
}

/* ---------- Regiones principales ---------- */
QFrame#frameMain {
    background: transparent;
}

QFrame#frameHeader {
    background-color: #D9EDF3;
    border: 1px solid rgba(255,255,255,18);
    border-radius: 12px;
}

QFrame#frameLeft {
    background-color: #D9EDF3;
    border: 1px solid rgba(0,135,174,60);
    border-radius: 14px;
}

QFrame#frameRight {
    background-color: #D9EDF3;
    border: 1px solid rgba(0,135,174,45);
    border-radius: 14px;
}

/* ---------- Labels ---------- */
QLabel {
    color: #0F1F2A;
}

QFrame#frameHeader QLabel {
    color: rgba(255,255,255,235);
}

QFrame#frameRight QLabel {
    color: #FFFFFF;
    background-color: #005282;
    border-radius: 8px;
    font-weight: bold;
}

/* ---------- Inputs ---------- */
QMainWindow#CalicataWindow QLineEdit,
QMainWindow#CalicataWindow QTextEdit,
QMainWindow#CalicataWindow QPlainTextEdit,
QMainWindow#CalicataWindow QDateEdit,
QMainWindow#CalicataWindow QComboBox {
    background-color: #FFFFFF;
    color: #0F1F2A;
    border: 1px solid rgba(0,135,174,70);
    border-radius: 10px;
    padding: 6px 8px;
}

QMainWindow#CalicataWindow QLineEdit:focus,
QMainWindow#CalicataWindow QTextEdit:focus,
QMainWindow#CalicataWindow QPlainTextEdit:focus,
QMainWindow#CalicataWindow QDateEdit:focus,
QMainWindow#CalicataWindow QComboBox:focus {
    border: 2px solid rgba(0,135,174,180);
}

QMainWindow#CalicataWindow QComboBox::drop-down {
    border-left: 1px solid rgba(0,135,174,70);
    width: 24px;
}

/* ---------- Botones base ---------- */
QPushButton {
    background-color: #FFFFFF;
    color: #005282;
    border: 1px solid rgba(0,135,174,70);
    border-radius: 12px;
    padding: 8px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: rgba(0,135,174,6);
}

QPushButton:pressed {
    background-color: rgba(0,135,174,10);
}

/* ---------- CTA naranja ---------- */
QPushButton#btnActualizarCoordenadas,
QPushButton#btnTituloCalicata {
    background-color: #FDAC11;
    border: 2px dashed #FFFFFF;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#btnActualizarCoordenadas:hover,
QPushButton#btnTituloCalicata:hover {
    background-color: #FFB52B;
    border: 2px dashed #FFFFFF;
}

QPushButton#btnActualizarCoordenadas:pressed,
QPushButton#btnTituloCalicata:pressed {
    background-color: #E59A00;
    border: 2px dashed #FFFFFF;
}

/* ---------- Header logos ---------- */
QFrame#frameHeaderLogo1,
QFrame#frameHeaderLogo2 {
    background-color: #005282;
    border: 1px solid rgba(255,255,255,22);
    border-radius: 12px;
}

QPushButton#btnLogoMTC,
QPushButton#btnLogoProyecto {
    background-color: #FFFFFF;
    color: #0F1F2A;
    border: 1px solid rgba(0,135,174,55);
    border-radius: 12px;
    padding: 8px;
}

QPushButton#btnLogoMTC:hover,
QPushButton#btnLogoProyecto:hover {
    background-color: #FFFFFF;
    border: 1px solid rgba(0,135,174,110);
}

QPushButton#btnLogoMTC:pressed,
QPushButton#btnLogoProyecto:pressed {
    background-color: #FFFFFF;
    border: 1px solid rgba(0,82,130,140);
}

/* ---------- Header datos ---------- */
QFrame#frameHeaderDatos {
    background-color: #005282;
    border: 1px solid rgba(255,255,255,22);
    border-radius: 12px;
}

/* ---------- Header: anti-achatado ---------- */
QFrame#frameHeader {
    min-height: 100px;
}

QFrame#frameHeaderLogo1,
QFrame#frameHeaderLogo2,
QFrame#frameHeaderDatos {
    min-height: 74px;
}

QFrame#frameHeader QLineEdit,
QFrame#frameHeader QComboBox,
QFrame#frameHeader QDateEdit {
    padding: 4px 8px;
    border-radius: 8px;
}

QFrame#frameHeader QPushButton {
    padding: 6px 10px;
    border-radius: 10px;
}

QFrame#frameHeader QToolButton {
    padding: 2px;
    border-radius: 8px;
}

/* ---------- Encabezado de cortes ---------- */
QFrame#frameEncabezadoCortes {
    background-color: #CCE7EF;
    border: 1px solid rgba(0,135,174,55);
    border-radius: 14px;
}

/* Grupos principales */
QFrame#FrameDescripcion,
QFrame#FrameMuestras,
QFrame#FrameEnsayos,
QFrame#FrameGranulometria,
QFrame#FramePlasticidad,
QFrame#FrameEstado_Natural {
    background-color: #005282;
    border: 1px solid rgba(0,0,0,10);
    border-radius: 10px;
}

QFrame#FrameDescripcion QLabel,
QFrame#FrameMuestras QLabel,
QFrame#FrameEnsayos QLabel,
QFrame#FrameGranulometria QLabel,
QFrame#FramePlasticidad QLabel,
QFrame#FrameEstado_Natural QLabel {
    color: #FFFFFF;
    font-weight: bold;
}

/* Sub-headers */
QFrame#FrameTipo,
QFrame#FrameIntervalo,
QFrame#FrameDE,
QFrame#FrameA,
QFrame#FrameMax,
QFrame#Frame2mm,
QFrame#Frame04mm,
QFrame#Frame008mm,
QFrame#FrameWL,
QFrame#FrameLP,
QFrame#FrameHumedad_2 {
    background-color: #005282;
    border: 1px solid rgba(0,0,0,10);
    border-radius: 10px;
}

QFrame#FrameTipo QLabel,
QFrame#FrameIntervalo QLabel,
QFrame#FrameDE QLabel,
QFrame#FrameA QLabel,
QFrame#FrameMax QLabel,
QFrame#Frame2mm QLabel,
QFrame#Frame04mm QLabel,
QFrame#Frame008mm QLabel,
QFrame#FrameWL QLabel,
QFrame#FrameLP QLabel,
QFrame#FrameHumedad_2 QLabel {
    color: #FFFFFF;
    font-weight: bold;
}

/* Vertical PNG labels */
QFrame#FrameHum,
QFrame#FrameExcava,
QFrame#FrameEstab,
QFrame#FrameAASHTO,
QFrame#FrameSUCS {
    background-color: #005282;
    border: 1px solid rgba(0,0,0,12);
    border-radius: 10px;
}

/* ---------- Zona cortes ---------- */
QScrollArea#scrollArea {
    background: transparent;
    border: none;
}

QScrollArea#scrollArea::viewport {
    background: transparent;
}

QWidget#scrollAreaWidgetContents {
    background: transparent;
}

QFrame#frameCortesContainer {
    background-color: #CCE7EF;
    border: 1px solid rgba(0,135,174,55);
    border-radius: 14px;
}

QFrame#frameButton {
    background-color: #CCE7EF;
    border: 1px solid rgba(0,82,130,35);
    border-radius: 14px;
}

/* ---------- Botón + ---------- */
QPushButton#btnAgregarCorte {
    background-color: #FFFFFF;
    border: 2px dashed rgba(253,172,17,170);
    border-radius: 18px;
    padding: 14px;
    qproperty-iconSize: 64px 64px;
}

QPushButton#btnAgregarCorte:hover {
    background-color: #FFFFFF;
    border: 2px solid #FDAC11;
}

QPushButton#btnAgregarCorte:pressed {
    background-color: rgba(253,172,17,10);
    border: 2px solid #FDAC11;
}

/* ---------- Footer observaciones ---------- */
QFrame#frameFooter {
    background-color: #005282;
    border: 1px solid rgba(0,135,174,55);
    border-radius: 14px;
}

QLabel#lblObservaciones {
    color: #FFFFFF;
    font-weight: bold;
}

QTextEdit#txtObservaciones,
QPlainTextEdit#txtObservaciones {
    background-color: #FFFFFF;
    color: #0F1F2A;
    border: 1px solid rgba(0,135,174,80);
    border-radius: 12px;
    padding: 10px;
}

QTextEdit#txtObservaciones QWidget,
QPlainTextEdit#txtObservaciones QWidget {
    background: transparent;
    border-radius: 12px;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: rgba(0,135,174,55);
    min-height: 26px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #0087AE;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: rgba(0,135,174,55);
    min-width: 26px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #0087AE;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------- Combo popup ---------- */
QMainWindow#CalicataWindow QComboBoxPrivateContainer {
    background-color: #005282;
    border: 1px solid rgba(255,255,255,28);
    border-radius: 12px;
    padding: 4px;
}

QMainWindow#CalicataWindow QComboBoxPrivateContainer QAbstractItemView {
    background-color: #005282;
    border: none;
    outline: 0;
    color: #FFFFFF;
    border-radius: 10px;
}

QMainWindow#CalicataWindow QComboBoxPrivateContainer QAbstractItemView::viewport {
    background-color: #005282;
    border-radius: 10px;
}

QMainWindow#CalicataWindow QComboBoxPrivateContainer QAbstractItemView::item {
    padding: 6px 10px;
    color: #FFFFFF;
    background: transparent;
}

QMainWindow#CalicataWindow QComboBoxPrivateContainer QAbstractItemView::item:hover {
    background-color: #FFFFFF;
    color: #0F1F2A;
}

QMainWindow#CalicataWindow QComboBoxPrivateContainer QAbstractItemView::item:selected {
    background-color: rgba(255,255,255,220);
    color: #0F1F2A;
}

QMainWindow#CalicataWindow QComboBoxPrivateContainer QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QMainWindow#CalicataWindow QComboBoxPrivateContainer QScrollBar::handle:vertical {
    background: rgba(255,255,255,35);
    border-radius: 5px;
    min-height: 18px;
}

QMainWindow#CalicataWindow QComboBoxPrivateContainer QScrollBar::handle:vertical:hover {
    background: rgba(255,255,255,55);
}

QMainWindow#CalicataWindow QComboBoxPrivateContainer QScrollBar::add-line:vertical,
QMainWindow#CalicataWindow QComboBoxPrivateContainer QScrollBar::sub-line:vertical {
    height: 0px;
}

QWidget#frameHeader QComboBox {
    combobox-popup: 0;
}

/* ---------- Menús ---------- */
QMenu {
    background-color: #005282;
    border: 1px solid rgba(255,255,255,28);
    border-radius: 12px;
    padding: 4px;
}

QMenu::item {
    color: #FFFFFF;
    padding: 6px 10px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: #FFFFFF;
    color: #0F1F2A;
}

/* ---------- Flecha visible en ComboBox + DateEdit ---------- */
QMainWindow#CalicataWindow QComboBox {
    padding-right: 26px;
}

QMainWindow#CalicataWindow QDateEdit {
    padding-left: 30px;
    padding-right: 26px;
}

QMainWindow#CalicataWindow QComboBox::drop-down,
QMainWindow#CalicataWindow QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid rgba(0,135,174,70);
    background: rgba(0,135,174,10);
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

QMainWindow#CalicataWindow QComboBox::drop-down:hover,
QMainWindow#CalicataWindow QDateEdit::drop-down:hover {
    background: rgba(0,135,174,18);
}

QMainWindow#CalicataWindow QComboBox::drop-down:pressed,
QMainWindow#CalicataWindow QDateEdit::drop-down:pressed {
    background: rgba(0,135,174,26);
}

QMainWindow#CalicataWindow QComboBox::down-arrow,
QMainWindow#CalicataWindow QDateEdit::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

/* =========================
   CALICATA — clear logos + fotos
   ========================= */
QMainWindow#CalicataWindow QToolButton#toolMTCClear,
QMainWindow#CalicataWindow QToolButton#toolLPClear,
QMainWindow#CalicataWindow QToolButton#toolFoto1Clear,
QMainWindow#CalicataWindow QToolButton#toolFoto2Clear,
QMainWindow#CalicataWindow QToolButton#toolFoto3Clear {
    background-color: #FFFFFF;
    border: 1px solid rgba(0,135,174,70);
    border-radius: 10px;
    padding: 2px;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
    qproperty-iconSize: 16px 16px;
}

QMainWindow#CalicataWindow QToolButton#toolMTCClear:hover,
QMainWindow#CalicataWindow QToolButton#toolLPClear:hover,
QMainWindow#CalicataWindow QToolButton#toolFoto1Clear:hover,
QMainWindow#CalicataWindow QToolButton#toolFoto2Clear:hover,
QMainWindow#CalicataWindow QToolButton#toolFoto3Clear:hover {
    background-color: #FFFFFF;
    border: 1px solid #0087AE;
}

QMainWindow#CalicataWindow QToolButton#toolMTCClear:pressed,
QMainWindow#CalicataWindow QToolButton#toolLPClear:pressed,
QMainWindow#CalicataWindow QToolButton#toolFoto1Clear:pressed,
QMainWindow#CalicataWindow QToolButton#toolFoto2Clear:pressed,
QMainWindow#CalicataWindow QToolButton#toolFoto3Clear:pressed {
    background-color: #0087AE;
    border: 1px solid #FFFFFF;
}

/* =========================
   CALICATA — pick fotos
   ========================= */
QMainWindow#CalicataWindow QToolButton#toolFoto1Pick,
QMainWindow#CalicataWindow QToolButton#toolFoto2Pick,
QMainWindow#CalicataWindow QToolButton#toolFoto3Pick {
    background-color: #FFFFFF;
    border: 1px solid rgba(0,135,174,70);
    border-radius: 10px;
    padding: 2px;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
    qproperty-iconSize: 16px 16px;
}

QMainWindow#CalicataWindow QToolButton#toolFoto1Pick:hover,
QMainWindow#CalicataWindow QToolButton#toolFoto2Pick:hover,
QMainWindow#CalicataWindow QToolButton#toolFoto3Pick:hover {
    background-color: #FFFFFF;
    border: 1px solid #0087AE;
}

QMainWindow#CalicataWindow QToolButton#toolFoto1Pick:pressed,
QMainWindow#CalicataWindow QToolButton#toolFoto2Pick:pressed,
QMainWindow#CalicataWindow QToolButton#toolFoto3Pick:pressed {
    background-color: #0087AE;
    border: 1px solid #FFFFFF;
}

/* ---------- Botones grandes de cámara ---------- */
QMainWindow#CalicataWindow QPushButton#btnFoto1,
QMainWindow#CalicataWindow QPushButton#btnFoto2,
QMainWindow#CalicataWindow QPushButton#btnFoto3 {
    background-color: #FFFFFF;
    color: #005282;
    border: 2px solid #005282;
    border-radius: 16px;
    padding: 0px;
}

QMainWindow#CalicataWindow QPushButton#btnFoto1:hover,
QMainWindow#CalicataWindow QPushButton#btnFoto2:hover,
QMainWindow#CalicataWindow QPushButton#btnFoto3:hover {
    background-color: #FFFFFF;
    border: 2px solid #0087AE;
    color: #0087AE;
}

QMainWindow#CalicataWindow QPushButton#btnFoto1:pressed,
QMainWindow#CalicataWindow QPushButton#btnFoto2:pressed,
QMainWindow#CalicataWindow QPushButton#btnFoto3:pressed {
    background-color: #005282;   /* borde normal al centro */
    border: 2px solid #FFFFFF;   /* fondo normal al borde */
    color: #FFFFFF;              /* signo/cámara blanco */
