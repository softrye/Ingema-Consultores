class _LiquidAuthBackdropState extends State<_LiquidAuthBackdrop>
    with SingleTickerProviderStateMixin {
  late final AnimationController controller;

  @override
  void initState() {
    super.initState();
    controller = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 12),
    );
    if (widget.animate &&
        widget.tokens.motionScale > 0 &&
        !widget.tokens.lowPerformance) {
      controller.repeat(reverse: true);
    }
  }

  @override
  void didUpdateWidget(covariant _LiquidAuthBackdrop oldWidget) {
    super.didUpdateWidget(oldWidget);
    final shouldAnimate =
        widget.animate &&
        widget.tokens.motionScale > 0 &&
        !widget.tokens.lowPerformance;
    if (shouldAnimate && !controller.isAnimating) {
      controller.repeat(reverse: true);
    } else if (!shouldAnimate && controller.isAnimating) {
      controller.stop();
    }
  }

  @override
  void dispose() {
    controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final dark = widget.tokens.dark;
    final accent = widget.palette.accent;
    final background = BoxDecoration(
      gradient: LinearGradient(
        begin: Alignment.topLeft,
        end: Alignment.bottomRight,
        colors: dark
            ? const [Color(0xff09131c), Color(0xff05080d)]
            : const [Color(0xffe6eef2), Color(0xfff1f4f5)],
      ),
    );
    if (!widget.animate) {
      return RepaintBoundary(child: DecoratedBox(decoration: background));
    }
    return RepaintBoundary(
      child: DecoratedBox(
        decoration: background,
        child: AnimatedBuilder(
          animation: controller,
          builder: (context, _) {
            final t = controller.value;
            return Stack(
              clipBehavior: Clip.none,
              children: [
                Positioned(
                  width: 390,
                  height: 390,
                  right: -150 + t * 26,
                  top: -170 + t * 18,
                  child: _AuthGlowOrb(
                    colors: [
                      accent.withValues(alpha: dark ? .58 : .40),
                      const Color(
                        0xff7c55d9,
                      ).withValues(alpha: dark ? .38 : .25),
                    ],
                  ),
                ),
                Positioned(
                  width: 430,
                  height: 430,
                  left: -220 + t * 34,
                  bottom: -170 - t * 14,
                  child: _AuthGlowOrb(
                    colors: [
                      const Color(
                        0xff7047ca,
                      ).withValues(alpha: dark ? .35 : .19),
                      const Color(
                        0xff25b8b0,
                      ).withValues(alpha: dark ? .30 : .22),
                    ],
                  ),
                ),
                Positioned(
                  width: 210,
                  height: 210,
                  right: -48,
                  bottom: 90 + t * 18,
                  child: _AuthGlowOrb(
