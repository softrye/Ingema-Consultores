<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Respaldo para Android en modo noche del sistema -->
    <style name="InGePlusTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">sans</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#202A36</item>
        <item name="android:navigationBarColor">#202A36</item>
        <item name="android:navigationBarDividerColor">#202A36</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <item name="android:windowBackground">#202A36</item>
        <item name="android:colorAccent">#2EC4B6</item>
    </style>

</resources>
