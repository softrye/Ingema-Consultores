                      <property name="styleSheet">
                       <string notr="true">QPushButton#btnOpenSesion {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #147AA6,
        stop:1 #0E5A7A
    );
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 10px;
    padding: 10px 14px;
    font-weight: 600;
}

QPushButton#btnOpenSesion:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #1A8CC0,
        stop:1 #11709A
    );
}

QPushButton#btnOpenSesion:pressed {
    background-color: #0B4761;
}

QPushButton#btnOpenSesion:disabled {
    background-color: #E8EEF3;
    color: rgba(27,42,78,0.45);
    border: 1px solid rgba(208,212,228,0.9);
}
</string>
                      </property>
