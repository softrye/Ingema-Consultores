         <property name="styleSheet">
          <string notr="true">/* ========= BASE (solo dentro de FrameContent) ========= */
QFrame#FrameContent {
    background: #FFFFFF;
}

/* Evita “fondos raros” del scroll (viewport) */
QScrollArea#scrollAreaContent,
QScrollArea#scrollAreaContent::viewport,
QWidget#scrollWidget,
QWidget#scrollAreaWidgetContents {
    background: #FFFFFF;
    border: none;
}

/* ========= TARJETA / CONTENEDOR ========= */
QFrame#frameProfileCard {
    background: #FFFFFF;
    border: 1px solid rgba(0, 83, 129, 45);   /* azul oscuro suave */
    border-top: 4px solid #FEAC10;            /* naranja */
    border-radius: 18px;
}

/* ========= INPUTS ========= */
QLineEdit {
    background: #FFFFFF;
    border: 1px solid rgba(0, 83, 129, 28);
    border-radius: 10px;
    padding: 10px 12px;
    color: #0B1F33;
}

QLineEdit:hover {
    border: 1px solid rgba(0, 141, 186, 70);  /* celeste */
}

QLineEdit:focus {
    border: 2px solid #008DBA;                /* celeste */
    padding: 9px 11px;                        /* compensa el borde 2px */
}

/* ========= BOTONES (base) ========= */
QPushButton {
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 600;
}

/* Guardar (primario) */
QPushButton#btnSaveProfile {
    background: #005381;                      /* azul oscuro */
    color: white;
    border: 1px solid rgba(0,0,0,20);
    border-left: 12px solid #FEAC10;          /* acento naranja visible */
    padding-left: 18px;
}

QPushButton#btnSaveProfile:hover {
    background: #008DBA;                      /* celeste */
}

QPushButton#btnSaveProfile:pressed {
    background: #00456B;
}

/* Cambiar avatar (secundario outline) */
QPushButton#btnChangeAvatar {
    background: transparent;
    color: #005381;
    border: 2px solid #008DBA;                /* celeste */
}

QPushButton#btnChangeAvatar:hover {
    background: rgba(0, 141, 186, 10);
}

QPushButton#btnChangeAvatar:pressed {
    background: rgba(0, 141, 186, 18);
}

/* ========= AVATAR ========= */
QLabel#lblAvatar {
    background: #FFFFFF;
    border: 2px solid rgba(254, 172, 16, 95); /* naranja */
    border-radius: 14px;
}


/* Reset avatar (terciario) */
QPushButton#btnResetAvatar {
    background: transparent;
    color: #7A8CA4;
    border: 1px solid rgba(0, 83, 129, 25);
}

QPushButton#btnResetAvatar:hover {
    background: rgba(0, 141, 186, 10);
    color: #005381;
}

QPushButton#btnResetAvatar:pressed {
    background: rgba(0, 141, 186, 18);
}</string>
